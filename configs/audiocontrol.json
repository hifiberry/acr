{
    "_comment": "Keys starting with _ are commented out",
    "action_plugins": [
        {
            "active-monitor": {
                "enabled": true
            }
        },
        {
            "event-logger": {
                "enabled": true,
                "event_types": [
                    "state",
                    "song",
                    "loop",
                    "capabilities",
                    "position",
                    "song_information_update",
                    "state_changed"
                ],
                "log_level": "info",
                "only_active": false
            }
        },
        {
            "lastfm": {
                "enabled": true,
                "api_key": "",
                "api_secret": "",
                "scrobble": true
            }
        }    ],
    "inputs": {
        "keyboard": {
            "_comment": "USB HID remote control support. Enabled by default. keymap replaces the built-in map when present; keys may be KEY_* names or raw numeric codes. Run audiocontrol_input_devices --watch to discover codes.",
            "enable": true,
            "volume_step": 5,
            "grab": false,
            "device": ""
        }
    },
    "services": {
        "webserver": {
            "enable": true,
            "host": "0.0.0.0",
            "port": 1080,
            "_static_routes": [
                {
                    "url_path": "/web",
                    "directory": "/usr/share/hifiberry-audiocontrol/sample-web"
                }
            ]
        },
        "datastore": {
            "attribute_cache": {
                "dbfile": "/var/lib/audiocontrol/cache/attributes.db",
                "memory_cache_records": 20000,
                "preload_prefixes": [
                    "artist::mbid"
                ]
            },
            "image_cache_path": "/var/lib/audiocontrol/cache/images",
            "user_image_path": "/var/lib/audiocontrol/user/images",
            "artist_store": {
                "cache_dir": "/var/lib/audiocontrol/cache/artists",
                "enable_custom_images": true,
                "auto_download": true
            }
        },
        "images": {
            "sizes": [100, 140, 200, 280, 400, 800],
            "prewarm_sizes": [140, 200, 280],
            "_comment": "Sizes the image endpoints offer via ?size=, and the subset the background job pre-generates. Both optional; these are the defaults. Each entry must be a non-negative integer no larger than u32::MAX; negative, non-integer, out-of-range, or duplicate entries are dropped with a warning, and if a key is present but not an array of numbers the default ladder is used, also with a warning. Pre-warm sizes outside the ladder are ignored. An empty prewarm_sizes turns pre-warming off."
        },
        "genre_cleanup": {
            "config_path": "/etc/audiocontrol/genre.json",
            "_comment": "Genre cleanup configuration file. Maps genres to normalized forms and specifies which genres to ignore."
        },
        "configurator": {
            "url": "http://localhost:1081",
            "_comment": "HiFiBerry configurator API integration for system information"
        },
        "volume": {
            "enable": true,
            "type": "alsa",
            "device": "",
            "control_name": "",
            "display_name": "Master Volume",
            "_comment": "ALSA volume control configuration. Leave device and control_name empty for auto-detection via configurator API. Auto-detection uses hw:X format where X is the hardware index from the configurator API and selects the appropriate mixer control. If auto-detection fails and no manual values are provided, volume control will be disabled."
        },
        "settingsdb": {
            "path": "/var/lib/audiocontrol/db"
        },
        "security_store": {
            "path": "/var/lib/audiocontrol/security_store.json"
        },
        "musicbrainz": {
            "enable": true,
            "rate_limit_ms": 1000
        },    
        "theaudiodb": {
            "enable": true,
            "api_key": "", 
            "rate_limit_ms": 500
        },
        "fanarttv": {
            "enable": true,
            "api_key": "",
            "rate_limit_ms": 500
        },
        "lastfm": {
            "enable": true,
            "api_key": "",
            "api_secret": "",
            "now_playing_enabled": true,
            "scrobble": true 
        },
        "spotify": {
            "enable": true,
            "oauth_url": "https://oauth.hifiberry.com/spotify/",
            "debug_mode": true,
            "api_enabled": false,
            "client_id": "",            
            "client_secret": ""
        }
    }
}
