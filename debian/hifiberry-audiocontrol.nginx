# HiFiBerry API proxy configuration
# This file should be included in the main nginx server block

# Proxy API requests to the backend service
#
# One location, one backend: today the player daemon and the metadata code
# share a process on 1080, so every path under /api/audiocontrol/ reaches the
# same Rocket and no path needs naming here.
#
# When that changes and this splits into per-daemon locations, /spotify/ goes
# to the **player** daemon, all of it -- /search included. The Spotify account
# belongs to the half that plays: the librespot backend turns every playback
# command into a Spotify Web API call, so the account and every route that
# manages it live there. Client URLs are unchanged either way.
location /api/audiocontrol/ {
    # Strip /api/audiocontrol prefix and proxy to backend
    proxy_pass http://127.0.0.1:1080/api/;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /api/audiocontrol;

    # WebSocket support for real-time features
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # POST request support
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_redirect off;

    # Increase buffer sizes for larger requests
    proxy_buffer_size 4k;
    proxy_buffers 8 4k;
    proxy_busy_buffers_size 8k;
    client_max_body_size 10M;

    # Timeout settings
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
}
