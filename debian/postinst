#!/bin/bash
set -e

# Copy a file and prove the copy matches, retrying if it does not.
#
# Every copy this script makes is taken while the *previous* daemon is still
# running: dh_installsystemd --restart-after-upgrade stops nothing in prerm, so
# the old process is still writing its files when configure runs. A plain cp of
# a file that changes underneath it produces a copy that is a mix of before and
# after, and for a SQLite database that is a corrupt file rather than a stale
# one.
#
# cmp against the source afterwards catches exactly that: if the source changed
# during the copy, the two differ and the copy is retried. Three attempts,
# because the write window is milliseconds and the race is not adversarial.
# Failing all three, the copy is removed rather than left in place -- see the
# settings-database block below for why a bad copy is worse than none.
#
# cmp is from diffutils, which is Essential, so this adds no dependency.
copy_verified() {
    _src="$1"
    _dst="$2"
    _attempt=1
    while [ "$_attempt" -le 3 ]; do
        if cp -p "$_src" "$_dst" 2>/dev/null && cmp -s "$_src" "$_dst"; then
            return 0
        fi
        _attempt=$((_attempt + 1))
    done
    rm -f "$_dst"
    return 1
}

# Make nginx read the API snippet this package just installed.
#
# Why this exists at all, and why it is new: /etc/nginx/hifiberry-api.d holds
# our snippet, nginx reads that directory only at start or reload, and before
# 0.23.0 every prefix in the snippet proxied to port 1080 either way -- so a
# config loaded months ago and the one just installed behaved identically, and
# the missing reload cost nothing. The split changed that. Seven metadata
# sub-prefixes and /api/metadata/ now go to 1084, the shipped player daemon is
# built without the metadata code and does not serve them at all, and a device
# still running the old config sends them to 1080 and gets 404 -- favourites,
# cover art and Last.fm all reported as broken providers by the web interface,
# with nothing in any log to say why.
#
# **Called from two places, and it has to be both.** The obvious mechanism is
# the dpkg trigger on /etc/nginx/hifiberry-api.d, which this package now also
# carries -- but dpkg does not activate a package's own file triggers for files
# that package itself installs. That was measured, not assumed: a test package
# carrying this exact interest and shipping a file into that directory was
# installed fresh and then upgraded twice with the file's content changing each
# time, and `postinst triggered` was never called once; its status never left
# "install ok installed". A neighbouring package dropping a snippet there, or
# removing one, activated it every time. So the trigger alone would have fixed
# the bug for everybody except the package that has it.
#
# The two callers therefore cover disjoint cases and cannot reload twice for
# one dpkg run:
#
#   configure  -- our own snippet changed. The only path that reaches this one.
#   triggered  -- somebody else's snippet in the directory changed.
#
# The configure call is at the very bottom of this script, after #DEBHELPER#,
# on purpose: dh_installsystemd's snippet there starts or restarts the two
# daemons, and reloading before it would point nginx at port 1084 while the
# process listening on it is still the pre-upgrade one. Reloading after it
# means the routing goes live once the daemon it routes to is up.
#
# Every branch below returns 0. This script runs under set -e, and a package
# that fails to configure because nginx is unhappy is worse than one that
# warns -- the same trade the migration steps in configure make.
reload_nginx() {
    # A cross-install: DPKG_ROOT is somebody else's filesystem, and the nginx
    # running here is not the one whose configuration changed. Never poke it.
    if [ -n "${DPKG_ROOT:-}" ]; then
        return 0
    fi

    # No systemd running -- a chroot, an image build -- so there is no service
    # to reload. The same guard the daemon stop in configure uses.
    if [ ! -d /run/systemd/system ]; then
        return 0
    fi

    # nginx not installed. A device that runs only the daemons is entitled to
    # have no proxy at all, and that is not a failure to configure.
    if ! command -v nginx >/dev/null 2>&1; then
        return 0
    fi

    # Installed but not running: stopped, masked, or never enabled. Whatever
    # starts it next reads the new snippet, so there is nothing to do and
    # nothing to warn about. Tested before reloading rather than letting the
    # reload fail, because `systemctl reload` on a stopped unit is an error and
    # this case is not one.
    if ! systemctl is-active --quiet nginx.service 2>/dev/null; then
        return 0
    fi

    # Validate first, and it is worth it for a reason that is not the obvious
    # one. A reload over a bad configuration does not kill nginx: the master
    # logs the error and carries on with the configuration it already has. That
    # is precisely the failure being fixed here -- the reload "succeeds", this
    # script says nothing, and the device goes on serving the old routing.
    # `nginx -t` is the only thing that separates that case from a real
    # success, so it turns a silent 404 into the warning below.
    #
    # It validates the whole configuration, snippets belonging to other
    # packages included, so a neighbour's syntax error stops our reload. That
    # is the right outcome -- reloading would not have applied our file either
    # -- but it is why the message names the configuration and not this
    # package.
    if ! nginx -t >/dev/null 2>&1; then
        echo "WARNING: the nginx configuration does not validate, so it was not reloaded (run 'nginx -t' for the reason); until it is, the metadata API prefixes still point at the old daemon and answer 404" >&2
        return 0
    fi

    # Reload, never restart. A restart drops every connection through the
    # proxy, and the player daemon's event WebSocket is one of them: every
    # connected client would have to notice and reconnect over a configuration
    # change it does not care about. A reload keeps them.
    #
    # deb-systemd-invoke rather than systemctl, matching the stop in configure:
    # it honours a policy-rc.d that forbids service actions, which is how a
    # build chroot says "install, but touch nothing".
    deb-systemd-invoke reload nginx.service >/dev/null 2>&1 || \
        echo "WARNING: could not reload nginx; the metadata API prefixes still point at the old daemon and answer 404 until 'systemctl reload nginx' succeeds" >&2

    return 0
}

# A package added, changed or removed a player definition in
# /etc/audiocontrol/players.d. merge_player_includes() only reads that
# directory at startup, so without this the new player never shows up.
# try-restart is a no-op while the service is not running yet, and the
# DPKG_ROOT guard keeps a cross-install from restarting the build host's
# daemon.
restart_player_daemon() {
    if [ -n "${DPKG_ROOT:-}" ] || [ ! -d /run/systemd/system ]; then
        return 0
    fi
    systemctl try-restart audiocontrol.service || true
    return 0
}

# Function to create user, group and directory
setup_user_and_dirs() {
    # Create audiocontrol group if it doesn't exist
    if ! getent group audiocontrol > /dev/null; then
        echo "Creating audiocontrol group..."
        groupadd --system audiocontrol
    fi
    
    # Create audiocontrol user if it doesn't exist
    if ! getent passwd audiocontrol > /dev/null; then
        echo "Creating audiocontrol user..."
        useradd --system --gid audiocontrol --shell /usr/sbin/nologin --home-dir /etc/audiocontrol audiocontrol
    fi
    
    # Add audiocontrol user to the audio group for audio device access
    if getent group audio > /dev/null; then
        echo "Adding audiocontrol user to audio group..."
        usermod -a -G audio audiocontrol
    fi

    # Input device access for USB HID remotes. /dev/input/event* is root:input
    # 0640, so audiocontrol must be in the input group to read a remote.
    if ! getent group input >/dev/null; then
        groupadd --system input
    fi
    usermod -a -G input audiocontrol

    # Create directory structure
    echo "Setting up directory structure..."
    mkdir -p /etc/audiocontrol
    mkdir -p /var/lib/audiocontrol/cache/attributes
    mkdir -p /var/lib/audiocontrol/cache/images
    mkdir -p /var/lib/audiocontrol
    
    # Fix permissions for all directories
    echo "Setting proper permissions..."
    chown audiocontrol:audiocontrol /etc/audiocontrol
    chmod 755 /etc/audiocontrol
    
    chown -R audiocontrol:audiocontrol /var/lib/audiocontrol /var/lib/audiocontrol/cache /var/lib/audiocontrol/cache/attributes /var/lib/audiocontrol/cache/images
    chmod 755 /var/lib/audiocontrol /var/lib/audiocontrol/cache /var/lib/audiocontrol/cache/attributes /var/lib/audiocontrol/cache/images
}

case "$1" in
    configure)
        setup_user_and_dirs

        # Player definitions moved from audiocontrol.json into players.d, one
        # file per providing package. An entry left behind in the main config
        # would be a duplicate: merge_player_includes() appends without
        # deduplicating, so the player would be instantiated twice.
        #
        # Gate on the previously-installed version ($2): this migration must
        # run exactly once, for installs upgrading from before 0.8.8. Without
        # the gate it would run on every future upgrade too, and since
        # strip_migrated_players() deletes any entry whose type is in its
        # static list unconditionally, it would silently delete a second,
        # user-added instance of a type (e.g. a second "mpd" block pointing at
        # a NAS) every time - the only place a second instance of a type can
        # live, since players.d/<type>.json is a conffile owned by the
        # providing package. [ -n "$2" ] also makes the fresh-install case an
        # explicit no-op rather than an incidental one.
        if [ -x /usr/bin/audiocontrol_migrate_players ] && \
           [ -n "$2" ] && dpkg --compare-versions "$2" lt 0.8.8; then
            /usr/bin/audiocontrol_migrate_players /etc/audiocontrol/audiocontrol.json || \
                echo "WARNING: could not migrate audiocontrol.json; check it for duplicate players" >&2
        fi

        # The metadata daemon gets its own security store now, at
        # /var/lib/audiocontrol/metadata/security_store.json, instead of
        # sharing /var/lib/audiocontrol/security_store.json with the player
        # daemon. SecurityStore::save_to_file serialises the whole in-memory
        # map with a truncating write, so two daemons writing one file would
        # have the second writer erase whatever the first had just written --
        # a real credential lost silently. The directory is created
        # unconditionally, every configure, because the metadata daemon needs
        # it regardless of whether there is anything to migrate into it.
        #
        # Every step below is allowed to fail without aborting postinst: this
        # runs under set -e, and a failure here must not leave the package
        # half-configured with its units never enabled. The trade is
        # deliberate -- a failed copy costs the user one re-link of an
        # account, a failed configure costs them a broken package.
        # metadata/images alongside it: services.datastore.image_cache_path in
        # metadata.json points there, and the image cache does not create its
        # own parent. Both directories, every configure, for the same reason --
        # the daemon needs them whether or not there is anything to migrate.
        mkdir -p /var/lib/audiocontrol/metadata /var/lib/audiocontrol/metadata/images || \
            echo "WARNING: could not create /var/lib/audiocontrol/metadata" >&2
        chown audiocontrol:audiocontrol /var/lib/audiocontrol/metadata /var/lib/audiocontrol/metadata/images || \
            echo "WARNING: could not set ownership on /var/lib/audiocontrol/metadata" >&2
        chmod 755 /var/lib/audiocontrol/metadata /var/lib/audiocontrol/metadata/images || \
            echo "WARNING: could not set permissions on /var/lib/audiocontrol/metadata" >&2

        # The settings database: db/settings.db ->
        # metadata/settings.db. It is not a cache. It holds the user's
        # favourite songs and the artist images they picked by hand, and
        # nothing rebuilds either -- lose the file and the favourites are gone
        # and every chosen image reverts to whatever the downloader fetches.
        #
        # Copied through copy_verified() rather than a bare cp, because a torn
        # copy of a SQLite file is worse than no copy at all, and that was
        # measured rather than assumed. Hand the daemon a half-copied
        # settings.db and it does not refuse to start: it logs "database disk
        # image is malformed" once, serves every route normally, and runs with
        # no settings database for the rest of that boot. It does not delete or
        # rebuild the file, so every restart after it does the same -- three in
        # a row were tried and the file was byte-for-byte unchanged. So the
        # daemon looks healthy, systemd sees no failure, Restart=on-failure
        # never fires, and the favourites are simply gone until somebody
        # deletes the file by hand. A copy that cannot be verified is therefore
        # removed, which puts the daemon on a fresh, working database instead.
        #
        # Guarded on the destination rather than on "$2", the same way the
        # security-store copy above is, and for the same two reasons: it makes
        # the copy idempotent across any number of configures, and it cannot
        # overwrite a database the metadata daemon has since written -- which a
        # version comparison would happily do on a downgrade-then-upgrade. The
        # source guard makes a fresh install a no-op. A copy, never a move: the
        # player daemon keeps reading its own file, and a rollback to the
        # previous version must find it where it left it.
        if [ -f /var/lib/audiocontrol/db/settings.db ] && \
           [ ! -f /var/lib/audiocontrol/metadata/settings.db ]; then
            # Quiesce the writer first. copy_verified() closes the window where
            # the source changes *during* the copy, but not the one where the
            # source is mid-transaction for the whole of it -- see the journal
            # handling below for what that costs. Favourite songs cannot be
            # reconstructed, so the window is not one to leave open.
            #
            # Inside the copy's own guard, not at the top of configure: the
            # destination guard means this whole block runs once in a device's
            # lifetime, and an upgrade that has nothing to copy must not pay a
            # service stop it does not need.
            #
            # A failed stop is not fatal, and not even especially bad -- the
            # copy still runs and copy_verified() still catches a torn result.
            # The stop removes a window; nothing here depends on it.
            #
            # dh_installsystemd --restart-after-upgrade brings the unit back at
            # the end of this script, so the cost is that playback stops a
            # moment earlier in an upgrade that was going to restart it anyway.
            if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
                deb-systemd-invoke stop audiocontrol.service >/dev/null 2>&1 || \
                    echo "WARNING: could not stop audiocontrol.service before copying settings.db; the copy is still verified, but a source being written during it may go undetected" >&2
            fi
            if copy_verified /var/lib/audiocontrol/db/settings.db \
                             /var/lib/audiocontrol/metadata/settings.db; then
                # The -journal sidecar has to travel with the database.
                #
                # The unit has TimeoutStopSec=10 and FinalKillSignal=SIGKILL, so
                # a player daemon that does not stop in time is killed, and a
                # killed SQLite writer leaves db/settings.db-journal behind.
                # Copying the .db alone then produces the worst result of the
                # three, and it was measured rather than guessed: the copy is
                # byte-identical to its source, so cmp passes it; PRAGMA
                # integrity_check on it says "ok"; the row count is right -- and
                # it contains rows the transaction never committed. In the case
                # measured, 4033 of 60000 rows held data that the device itself
                # rolled back on its next open. Nothing anywhere reports that:
                # not cmp, not integrity_check, not the daemon's log. The
                # metadata daemon would simply hold a settings database that
                # quietly disagrees with the player daemon's.
                #
                # With the journal copied beside it, SQLite finds a hot journal
                # on first open, rolls it back, removes it, and the result
                # matched the pre-transaction content exactly -- the same state
                # the source itself recovers to. So the sidecar is copied rather
                # than the copy being refused: settings.db holds favourites and
                # artist image choices that nothing can rebuild, and rolling
                # back is precisely what SQLite is for.
                #
                # If the journal cannot be brought across, both files are
                # removed. A .db whose journal was left behind is the silent
                # case above; a fresh empty database is honest by comparison.
                #
                # The final cmp re-checks the .db after the journal copy: with
                # the stop refused, the daemon could have committed in between,
                # which would leave the pair mismatched -- a journal older than
                # the database it would be rolled back into.
                if [ -f /var/lib/audiocontrol/db/settings.db-journal ]; then
                    if copy_verified /var/lib/audiocontrol/db/settings.db-journal \
                                     /var/lib/audiocontrol/metadata/settings.db-journal && \
                       cmp -s /var/lib/audiocontrol/db/settings.db \
                              /var/lib/audiocontrol/metadata/settings.db; then
                        chown audiocontrol:audiocontrol /var/lib/audiocontrol/metadata/settings.db-journal || \
                            echo "WARNING: could not set ownership on the metadata daemon's settings.db-journal" >&2
                    else
                        rm -f /var/lib/audiocontrol/metadata/settings.db \
                              /var/lib/audiocontrol/metadata/settings.db-journal
                        echo "WARNING: settings.db was left mid-transaction and its journal could not be copied with it; the metadata daemon will start on an empty settings database, so favourite songs and chosen artist images will need to be set again" >&2
                    fi
                fi
                if [ -f /var/lib/audiocontrol/metadata/settings.db ]; then
                    chown audiocontrol:audiocontrol /var/lib/audiocontrol/metadata/settings.db || \
                        echo "WARNING: could not set ownership on the metadata daemon's settings.db" >&2
                fi
            else
                echo "WARNING: could not copy settings.db to the metadata daemon's directory; favourite songs and chosen artist images will need to be set again" >&2
            fi
        fi

        # Copy -- never move -- the existing credential store into the metadata
        # daemon's new path. The two file guards are the whole condition: the
        # source guard makes a fresh install (nothing to migrate) a no-op, and
        # the destination guard makes this idempotent and unable to clobber a
        # Last.fm login the metadata daemon has since written there, regardless
        # of how many times or from which previous version configure runs. Both
        # files then hold every key; each daemon writes only the ones it owns,
        # and the foreign entries left behind are inert. A move, or a migration
        # that deleted the foreign keys, could unlink a real Spotify or Last.fm
        # account if it failed partway; a stray inert key costs nothing.
        #
        # Below the settings-database block, not above it, so that on the one
        # upgrade where both guards fire this copy is taken from a player daemon
        # that has already been stopped. It costs no additional stop: the block
        # above only stops the daemon when it is itself going to copy.
        #
        # Still a bare cp, deliberately, where the settings database uses
        # copy_verified(). It fails differently: a torn JSON file does not
        # parse, the metadata daemon starts on an empty store, and Last.fm shows
        # as unlinked -- visible, and fixed by linking it again. That is a
        # better failure than a binary database that passes every check and
        # holds the wrong rows.
        if [ -f /var/lib/audiocontrol/security_store.json ] && \
           [ ! -f /var/lib/audiocontrol/metadata/security_store.json ]; then
            cp -p /var/lib/audiocontrol/security_store.json \
                  /var/lib/audiocontrol/metadata/security_store.json || \
                echo "WARNING: could not copy security_store.json to the metadata daemon's path; Last.fm and Spotify accounts may need to be re-linked" >&2
            chown audiocontrol:audiocontrol /var/lib/audiocontrol/metadata/security_store.json || \
                echo "WARNING: could not set ownership on the metadata daemon's security_store.json" >&2
        fi

        # The lookup cache -- cache/attributes.db -- is deliberately NOT
        # copied, and this is a departure from the spec, which asked for it.
        #
        # It is the one file the old daemon writes continuously: every
        # enrichment writes to it, so the copy window is never quiet, and it is
        # by far the largest of the three. It also has no verification worth
        # having here, because unlike settings.db a mismatch is the expected
        # case rather than the exception. Set against that, it is a pure cache
        # of MusicBrainz and TheAudioDB answers: the daemon creates an empty
        # one, refills it as it goes, and the only cost is some repeated
        # external lookups over the following days.
        #
        # So the trade is a few days of slower lookups against a chance of the
        # permanently cache-less daemon described above. The cache is not worth
        # that, and this is the cheaper of the two by a wide margin.

        # The provider API keys in /etc/audiocontrol/audiocontrol.json are
        # deliberately NOT migrated either. That one is a close call, so here is
        # the reasoning and not just the outcome.
        #
        # What moved: action_plugins.lastfm and the services.{lastfm,
        # musicbrainz, theaudiodb, fanarttv, external_coverart} sections are
        # read out of /etc/audiocontrol/metadata.json now. Nothing in the
        # shipped player daemon reads them from audiocontrol.json any more --
        # it is built without the metadata crate, so every consumer of them is
        # gone from the binary. A user who set a key by hand keeps it in a file
        # nothing reads, while the daemon that needs it starts on the built-in
        # default. For Last.fm that is worse than a plain fallback: the session
        # key copied across above was issued against the user's own API key, so
        # it is refused while the account still shows as linked.
        #
        # Why this script does not fix it: migrating means writing to
        # metadata.json, and metadata.json is a conffile. dpkg identifies a
        # conffile by its checksum, so a postinst that edits it marks the file
        # locally modified on every device it runs on, permanently. From then
        # on any release that changes metadata.json either prompts -- and an
        # unattended upgrade answers "keep the local file", silently, so the
        # new defaults never arrive -- or has to be forced past that prompt.
        # Every installation pays that, for good, to repair a file that is
        # untouched wherever no key was ever set by hand.
        #
        # Doing it correctly would also need a JSON parser here. Both files
        # carry comment keys and whatever formatting the user's editor left, so
        # a line-oriented edit would eventually corrupt a working configuration
        # -- a much worse failure than the one being fixed -- and jq is not
        # Essential, so it would mean a new package dependency for an edit made
        # once in a device's lifetime.
        #
        # The changelog carries it instead: it names the sections, says the
        # values are not copied, and gives the one edit that fixes it. If this
        # is revisited, the thing to weigh is the conffile and not the edit. A
        # migration that wrote to a drop-in that is not a conffile, or a daemon
        # that read the old file as a fallback and said so in its log, would
        # carry none of the cost above.
        ;;

    triggered)
        # $2 is the space-separated list of triggers dpkg has coalesced into
        # this one call. The two interests want opposite things -- a changed
        # player definition must restart the player daemon, a changed nginx
        # snippet must not -- so this dispatches on the name instead of doing
        # both. Doing both would mean every neighbouring package that drops an
        # API snippet also drops playback, which is a worse bug than the one
        # this trigger fixes.
        #
        # Unquoted on purpose: the list is one argument and has to be split.
        # Trigger names are absolute paths from our own triggers file, so there
        # is nothing here to glob.
        for _trigger in $2; do
            case "$_trigger" in
                /etc/audiocontrol/players.d)
                    restart_player_daemon
                    ;;
                /etc/nginx/hifiberry-api.d)
                    reload_nginx
                    ;;
            esac
        done

        # dpkg has passed the trigger list since 1.14.17 and every supported
        # release is far past that, so an empty $2 should not happen. If it
        # ever does, fall back to what this arm did when players.d was its only
        # interest, plus the reload -- a spurious restart and a spurious reload
        # are both cheap, and silently doing nothing would put the 404s back.
        if [ -z "${2:-}" ]; then
            restart_player_daemon
            reload_nginx
        fi
        ;;
esac

#DEBHELPER#

# nginx last, deliberately below #DEBHELPER# rather than inside the configure
# arm above. The debhelper snippet is what starts audiocontrol.service and
# audiocontrol-metadata.service, and this snippet's metadata prefixes point at
# the port the second one listens on -- reload before that and nginx routes to
# a daemon that is not up yet; reload after it and the new routing goes live
# together with the daemon that answers it.
#
# Only for "configure": an abort-upgrade or abort-remove has not installed a
# new snippet, so there is nothing for nginx to pick up. See reload_nginx()
# above for why the trigger cannot cover this case.
#
# Not gated on "$2", unlike the once-only migrations in the configure arm. A
# reload is idempotent and cheap, the snippet is a conffile that a local edit
# can change on any upgrade, and dpkg does not tell postinst whether this
# particular upgrade rewrote it. Reloading every configure is therefore both
# correct and the only version that cannot miss a change; gating it on a
# version comparison would buy nothing and could reinstate the 404s.
if [ "$1" = "configure" ]; then
    reload_nginx
fi

exit 0
