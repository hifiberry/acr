#!/bin/bash
set -e

# Function to create user, group and directory
setup_user_and_dirs() {
    # Create audiocontrol group if it doesn't exist
    if ! getent group audiocontrol > /dev/null; then
        echo "Creating audiocontrol group..."
        groupadd --system audiocontrol
    fi
    
    # Create audiocontrol user if it doesn't exist
    if ! getent passwd audiocontrol > /dev/null; then
        echo "Creating audiocontrol user..."
        useradd --system --gid audiocontrol --shell /usr/sbin/nologin --home-dir /etc/audiocontrol audiocontrol
    fi
    
    # Add audiocontrol user to the audio group for audio device access
    if getent group audio > /dev/null; then
        echo "Adding audiocontrol user to audio group..."
        usermod -a -G audio audiocontrol
    fi

    # Input device access for USB HID remotes. /dev/input/event* is root:input
    # 0640, so audiocontrol must be in the input group to read a remote.
    if ! getent group input >/dev/null; then
        groupadd --system input
    fi
    usermod -a -G input audiocontrol

    # Create directory structure
    echo "Setting up directory structure..."
    mkdir -p /etc/audiocontrol
    mkdir -p /var/lib/audiocontrol/cache/attributes
    mkdir -p /var/lib/audiocontrol/cache/images
    mkdir -p /var/lib/audiocontrol
    
    # Fix permissions for all directories
    echo "Setting proper permissions..."
    chown audiocontrol:audiocontrol /etc/audiocontrol
    chmod 755 /etc/audiocontrol
    
    chown -R audiocontrol:audiocontrol /var/lib/audiocontrol /var/lib/audiocontrol/cache /var/lib/audiocontrol/cache/attributes /var/lib/audiocontrol/cache/images
    chmod 755 /var/lib/audiocontrol /var/lib/audiocontrol/cache /var/lib/audiocontrol/cache/attributes /var/lib/audiocontrol/cache/images
}

case "$1" in
    configure)
        setup_user_and_dirs

        # Player definitions moved from audiocontrol.json into players.d, one
        # file per providing package. An entry left behind in the main config
        # would be a duplicate: merge_player_includes() appends without
        # deduplicating, so the player would be instantiated twice.
        #
        # Gate on the previously-installed version ($2): this migration must
        # run exactly once, for installs upgrading from before 0.8.8. Without
        # the gate it would run on every future upgrade too, and since
        # strip_migrated_players() deletes any entry whose type is in its
        # static list unconditionally, it would silently delete a second,
        # user-added instance of a type (e.g. a second "mpd" block pointing at
        # a NAS) every time - the only place a second instance of a type can
        # live, since players.d/<type>.json is a conffile owned by the
        # providing package. [ -n "$2" ] also makes the fresh-install case an
        # explicit no-op rather than an incidental one.
        if [ -x /usr/bin/audiocontrol_migrate_players ] && \
           [ -n "$2" ] && dpkg --compare-versions "$2" lt 0.8.8; then
            /usr/bin/audiocontrol_migrate_players /etc/audiocontrol/audiocontrol.json || \
                echo "WARNING: could not migrate audiocontrol.json; check it for duplicate players" >&2
        fi

        # The metadata daemon gets its own security store now, at
        # /var/lib/audiocontrol/metadata/security_store.json, instead of
        # sharing /var/lib/audiocontrol/security_store.json with the player
        # daemon. SecurityStore::save_to_file serialises the whole in-memory
        # map with a truncating write, so two daemons writing one file would
        # have the second writer erase whatever the first had just written --
        # a real credential lost silently. The directory is created
        # unconditionally, every configure, because the metadata daemon needs
        # it regardless of whether there is anything to migrate into it.
        #
        # Every step below is allowed to fail without aborting postinst: this
        # runs under set -e, and a failure here must not leave the package
        # half-configured with its units never enabled. The trade is
        # deliberate -- a failed copy costs the user one re-link of an
        # account, a failed configure costs them a broken package.
        mkdir -p /var/lib/audiocontrol/metadata || \
            echo "WARNING: could not create /var/lib/audiocontrol/metadata" >&2
        chown audiocontrol:audiocontrol /var/lib/audiocontrol/metadata || \
            echo "WARNING: could not set ownership on /var/lib/audiocontrol/metadata" >&2
        chmod 755 /var/lib/audiocontrol/metadata || \
            echo "WARNING: could not set permissions on /var/lib/audiocontrol/metadata" >&2

        # Copy -- never move -- the existing store into the metadata daemon's
        # new path. The two file guards are the whole condition: the source
        # guard makes a fresh install (nothing to migrate) a no-op, and the
        # destination guard makes this idempotent and unable to clobber a
        # Last.fm login the metadata daemon has since written there,
        # regardless of how many times or from which previous version
        # configure runs. Both files then hold every key; each daemon writes
        # only the ones it owns, and the foreign entries left behind are
        # inert. A move, or a migration that deleted the foreign keys, could
        # unlink a real Spotify or Last.fm account if it failed partway; a
        # stray inert key costs nothing.
        if [ -f /var/lib/audiocontrol/security_store.json ] && \
           [ ! -f /var/lib/audiocontrol/metadata/security_store.json ]; then
            cp -p /var/lib/audiocontrol/security_store.json \
                  /var/lib/audiocontrol/metadata/security_store.json || \
                echo "WARNING: could not copy security_store.json to the metadata daemon's path; Last.fm and Spotify accounts may need to be re-linked" >&2
            chown audiocontrol:audiocontrol /var/lib/audiocontrol/metadata/security_store.json || \
                echo "WARNING: could not set ownership on the metadata daemon's security_store.json" >&2
        fi
        ;;

    triggered)
        # A package added, changed or removed a player definition in
        # /etc/audiocontrol/players.d. merge_player_includes() only reads that
        # directory at startup, so without this the new player never shows up.
        # try-restart is a no-op while the service is not running yet.
        if [ -d /run/systemd/system ]; then
            systemctl try-restart audiocontrol.service || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
