{
    "action_plugins": [
        {
            "active-monitor": {
                "enabled": true
            }
        },
        {
            "event-logger": {
                "enabled": true,
                "event_types": [
                    "state",
                    "song"
                ],
                "log_level": "info",
                "only_active": false
            }
        }
    ],
    "services": {
        "webserver": {
            "enable": true,
            "host": "127.0.0.1",
            "port": 18080
        },
        "cache": {
            "attribute_cache_path": "/tmp/test_cache/attributes",
            "image_cache_path": "/tmp/test_cache/images"
        },
        "settingsdb": {
            "path": "/tmp/test_db"
        },
        "security_store": {
            "path": "/tmp/test_security_store.json"
        },
        "musicbrainz": {
            "enable": false
        },
        "theaudiodb": {
            "enable": false,
            "api_key": "",
            "rate_limit_ms": 500
        },
        "lastfm": {
            "enable": true,
            "api_key": "test_api_key",
            "api_secret": "test_api_secret",
            "now_playing_enabled": false,
            "scrobble": false
        },
        "spotify": {
            "enable": false
        },
        "_comment_no_metadata_section": "There is deliberately no services.metadata here, and adding one would do nothing: the daemon holds no client for the metadata daemon. Every test in test_metadata_seams.py runs against a daemon started without it, which is what proves it ignites and still serves the metadata routes.",
        "core": {
            "url": "http://127.0.0.1:18080/api",
            "_comment_poll": "library_poll_seconds is deliberately unset, so this suite runs the production backstop of 600s. It used to be 30s here, which meant a test observing enrichment could pass through the poll while the event path was entirely broken -- the poll would have to outlive the whole suite to say anything now."
        }
    },
    "players": [
        {
            "generic": {
                "name": "test",
                "enable": true,
                "supports_api_events": true,
                "capabilities": ["play", "pause", "stop", "next", "previous", "seek", "shuffle", "loop", "killable"],
                "initial_state": "stopped",
                "shuffle": false,
                "loop_mode": "none"
            }
        }
    ]
}
